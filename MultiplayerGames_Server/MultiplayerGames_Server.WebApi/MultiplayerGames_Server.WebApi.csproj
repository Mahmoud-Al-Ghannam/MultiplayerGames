<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <UserSecretsId>b5e5192d-b88a-427e-861c-3711a6644adf</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.14" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Common\" />
    <Folder Include="Controllers\" />
    <Folder Include="DependencyInjection\" />
    <Folder Include="Hangfire\" />
    <Folder Include="Middlewares\" />
    <Folder Include="Requests\" />
    <Folder Include="Requests\Auth\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MultiplayerGames_Server.Application\MultiplayerGames_Server.Application.csproj" />
    <ProjectReference Include="..\MultiplayerGames_Server.Domain\MultiplayerGames_Server.Domain.csproj" />
    <ProjectReference Include="..\MultiplayerGames_Server.Infrastructure.SignalR\MultiplayerGames_Server.Infrastructure.SignalR.csproj" />
    <ProjectReference Include="..\MultiplayerGames_Server.Infrastructure\MultiplayerGames_Server.Infrastructure.csproj" />
  </ItemGroup>
</Project>
